using "platforms/cpus/zynqmp.repl"

// additional UART for BLE RCP
uart2: UART.Cadence_UART @ sysbus 0xff080000
    -> apuGic@48

// VirtIO disk for matter tools
matter_virtio: Storage.VirtIOBlockDevice @ sysbus 0xfe400200
    IRQ -> apuGic@33

// The ZynqMP platform provides GEM MACs but only gives gem0 a PHY.
// Attach a PHY to gem3 so Linux can discover a link on its MDIO bus.
phy3: Network.EthernetPhysicalLayer @ gem3 12
    BasicStatus: 0x62A4
    Id1: 0x0141
    Id2: 0x0e40
    AutoNegotiationAdvertisement: 0x1e1
    AutoNegotiationLinkPartnerBasePageAbility: 0x1e1
    MasterSlaveControl: 0x300
    MasterSlaveStatus: 0x3000
