using "platforms/cpus/silabs/efr32s2/efr32xG23.repl"

led0: Miscellaneous.LED @ gpioPort 18  // PB02

led1: Miscellaneous.LED @ gpioPort 51  // PD03

gpioPort:
    18 -> led0@0
    51 -> led1@0

button0: Miscellaneous.Button @ gpioPort 17  // PB01
    -> gpioPort@17

button1: Miscellaneous.Button @ gpioPort 19  // PB03
    -> gpioPort@19

sram:
    size: 0x10000 

flash:
    size: 0x80000


deviceInformation:
    deviceNumber: 1210

radio:
    paLPSupport: true
    paHPSupport: true

lockbitsdata: Miscellaneous.SiLabs.SiLabs_LockbitsData @ sysbus 0x0817E000
    size: 0x2000

msc:
    flashSize: 0x80000
    flashPageSize: 0x2000